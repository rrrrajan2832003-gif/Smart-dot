<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_data_root"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:layout_gravity="center"
    android:background="@drawable/bg_widget_data_tile"
    android:clickable="true"
    android:focusable="true"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_data_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:contentDescription="@string/widget_data_label"
        android:src="@drawable/ic_widget_mobile_data" />

</FrameLayout>
