<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A6000000"> <!-- Semi-transparent black backdrop -->

    <LinearLayout
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_popup_panel"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility Required"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accessibility permission lets Floating Shortcuts trigger system navigation (Back, Home, Recents, Notifications) and read visible on-screen text elements for instant Screen Text Copy and Screen Translate without taking screenshots.\n\nEnable 'Floating Shortcuts' in Accessibility settings?"
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_cancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#94A3B8"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#00E5FF"
                android:text="Enable"
                android:textColor="#0F172A"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
