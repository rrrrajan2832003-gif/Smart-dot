<?xml version="1.0" encoding="utf-8"?>
<com.example.InlineOverlayRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inline_ocr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Full-screen completely transparent interactive canvas aligned 1:1 over live screen -->
    <com.example.InlineTextSelectionView
        android:id="@+id/inline_ocr_selection_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Transparent screen text overlay" />

    <!-- Compact Top-Right Controls Pill (Language Switcher in Translate mode + Rescan + Close) -->
    <LinearLayout
        android:id="@+id/inline_ocr_controls_pill"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btn_inline_translate_mode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Toggle Online Fast Translation Mode"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/screen_translate_mode_online"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_inline_target_lang"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:text="Hindi ▾"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_inline_ocr_rescan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/screen_copy_rescan"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ocr_refresh" />

        <LinearLayout
            android:id="@+id/btn_inline_ocr_close"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/screen_copy_close"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_app_close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/screen_copy_close"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact In-Overlay Language Picker Dropdown for Screen Translate -->
    <LinearLayout
        android:id="@+id/inline_lang_dropdown"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="12dp"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- Brief status pill while bulk offline translation prepares/runs -->
    <TextView
        android:id="@+id/tv_inline_status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="66dp"
        android:elevation="9dp"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="@string/screen_translate_translating"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Unified 5x2 Icon-Only Toolbar + Direct AI Question Box for Text Selection -->
    <LinearLayout
        android:id="@+id/inline_word_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inline_word_row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/inline_word_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/inline_word_question_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:minWidth="210dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <EditText
                android:id="@+id/et_word_ai_question"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Ask about this text/image..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_word_preset_1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_preset_1_desc"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tab_translate" />

            <ImageButton
                android:id="@+id/btn_word_preset_2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_preset_2_desc"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_preset_meaning" />

            <ImageButton
                android:id="@+id/btn_word_ai_send"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send question to AI"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_send" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inline_word_browser_ai_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:minWidth="210dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <EditText
                android:id="@+id/et_word_browser_ai_question"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/floating_ai_question_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_word_browser_ai_send"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ask directly in Floating Google AI"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_send" />
        </LinearLayout>
    </LinearLayout>

    <!-- Compact Inline Popup Bubble for Highlighted Word / Cutout OCR Translation -->
    <LinearLayout
        android:id="@+id/inline_word_translate_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:elevation="11dp"
        android:gravity="center_vertical"
        android:maxWidth="280dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_inline_word_translated_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="210dp"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_inline_word_translate_copy"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:contentDescription="Copy translated phrase"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/screen_copy_action"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Unified 5x2 Icon-Only Toolbar + Direct AI Question Box + Close for Circle-to-Search Cutout Box -->
    <LinearLayout
        android:id="@+id/inline_cutout_action_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:elevation="11dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/inline_cutout_row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/inline_cutout_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/inline_cutout_question_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:minWidth="220dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <EditText
                android:id="@+id/et_cutout_ai_question"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Ask about this text/image..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_cutout_preset_1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_preset_1_desc"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tab_translate" />

            <ImageButton
                android:id="@+id/btn_cutout_preset_2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_preset_2_desc"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_preset_meaning" />

            <ImageButton
                android:id="@+id/btn_cutout_ai_send"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send question to AI"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_send" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="#475569" />

            <ImageButton
                android:id="@+id/btn_cutout_close"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Cutout Box"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_app_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inline_cutout_browser_ai_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:minWidth="220dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <EditText
                android:id="@+id/et_cutout_browser_ai_question"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/floating_ai_question_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="#F8FAFC"
                android:textColorHint="#94A3B8"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btn_cutout_browser_ai_send"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ask directly in Floating Google AI"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_send" />
        </LinearLayout>
    </LinearLayout>

</com.example.InlineOverlayRootLayout>
